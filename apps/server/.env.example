NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/projeto-home.sqlite
STORAGE_ROOT=./data/storage
LOG_DIRECTORY=./var/log
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=7
OPERATIONAL_LOG_QUERY_MAX_BYTES=2097152
AUDIT_RETENTION_DAYS=365
ERROR_RETENTION_DAYS=90
EVENT_RETENTION_BATCH_SIZE=500
LOCAL_AI_BASE_URL=http://127.0.0.1:8080
LOCAL_AI_MODEL=Qwen3-1.7B-Q4_K_M
LOCAL_AI_TIMEOUT_MS=60000
LOCAL_AI_MAX_INPUT_CHARS=8192
LOCAL_AI_MAX_OUTPUT_TOKENS=128
